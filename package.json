{
  "name": "yaf-extension",
  "repository": {
    "type": "git",
    "url": "https://github.com/falsefalse/yaf-extension.git"
  },
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "prerelease": "git stash -q && yarn -s tsc && yarn -s lint && yarn -s test --reporter=dot",
    "release": "jake -q clean ${TASK:-release} && open ./pkg",
    "release:firefox": "TASK=release:firefox yarn -s release",
    "release:tag": "v=$npm_package_version ; git tag -a -m 🏷 $v HEAD && git push --tags 2>&1 | grep $v",
    "lint": "yarn -s prettier --check & p=$! ; oxlint --type-aware ||s=1 ; wait $p||s=1 ; exit $s",
    "prettier": "prettier -u --log-level warn --ignore-path .gitignore .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --reporter=dot",
    "report": "yarn -s coverage && open coverage/index.html"
  },
  "engines": {
    "node": ">=26",
    "yarn": "~1.22"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^26.5.1",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@webext-core/fake-browser": "^2.0.1",
    "@wxt-dev/browser": "^0.2.9",
    "jake": "^12.10.1",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
