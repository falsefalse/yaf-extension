{
  "folders": [
    {
      "name": "YAF",
      "path": ".",
      "folder_exclude_patterns": ["node_modules"],
      "file_exclude_patterns": ["*.sublime-workspace", "yarn.lock"]
    }
  ],
  "settings": {},
  "build_systems": [
    {
      "name": "lint 🕵",
      "cmd": ["yarn", "lint"],
      // oxlint `file:line:col: message` and prettier `[warn] file`
      "file_regex": "^(?:\\[warn\\] )?(\\S+?)(?::(\\d+):(\\d+): (.*))?$",
      "auto_close": true,
      "focus": true,

      "working_dir": "$project_path",
      "target": "terminus_exec"
    },

    {
      "name": "tc 🦜",
      "cmd": ["yarn", "tsc"],
      // tsc errors
      "file_regex": "^(\\S+):(\\d+):(\\d+).*(error.*)$",
      "auto_close": true,
      "focus": true,

      "working_dir": "$project_path",
      "target": "terminus_exec"
    },

    {
      "name": "build 👷",
      "cmd": ["jake"],
      "auto_close": true,

      "working_dir": "$project_path",
      "target": "terminus_exec"
    },

    {
      "name": "build:ff 🦊",
      "cmd": ["jake", "firefox"],
      "auto_close": true,

      "working_dir": "$project_path",
      "target": "terminus_exec"
    },

    {
      "name": "clean 🧹",
      "cmd": ["jake", "clean"],
      "auto_close": true,

      "working_dir": "$project_path",
      "target": "terminus_exec"
    },

    {
      "name": "test 🧪",
      "cmd": ["yarn", "-s", "test"],
      // vitest stack frames, `❯ [fn] file:line:col`, skipping node_modules
      "file_regex": "^\\s*❯ (?:\\S+ )?((?!node_modules)\\S+?):(\\d+):(\\d+)$",
      "auto_close": false,
      "focus": true,

      "working_dir": "$project_path",
      "target": "terminus_exec"
    }
  ]
}
